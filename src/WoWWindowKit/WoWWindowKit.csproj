<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../../docs/assets/logo.ico</ApplicationIcon>
    <Version>1.0.10</Version>
    <Company>David-c0degeek</Company>
    <Description>WoW layouts, main-window swapping, and mouse focus.</Description>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="../../settings.default.json" Link="settings.default.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
